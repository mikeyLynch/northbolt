<%- content_for :title, "Set new password — LockMono" %>

<div class="bg-white border border-gray-200 rounded-xl p-8">
  <h1 class="text-xl font-bold text-gray-900 mb-1">Set a new password</h1>
  <p class="text-sm text-gray-500 mb-8">Choose a new password for your account.</p>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
    <%= f.hidden_field :reset_password_token %>

    <div class="space-y-5">
      <div>
        <%= f.label :password, "New password", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
              class: "w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
      </div>

      <%= f.submit "Change password", class: "w-full bg-gray-900 text-white hover:bg-gray-700 px-5 py-2.5 rounded-lg text-sm font-semibold transition-colors cursor-pointer" %>
    </div>
  <% end %>
</div>

<% if resource.errors.any? %>
  <ul class="mt-4 space-y-1">
    <% resource.errors.full_messages.each do |msg| %>
      <li class="text-center text-sm text-gray-500"><%= msg %></li>
    <% end %>
  </ul>
<% end %>
