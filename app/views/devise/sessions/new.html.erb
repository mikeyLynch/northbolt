<%- content_for :title, "Sign in — LockMono" %>

<div class="bg-white border border-gray-200 rounded-xl p-8">
  <h1 class="text-xl font-bold text-gray-900 mb-1">Sign in</h1>
  <p class="text-sm text-gray-500 mb-8">Enter your details to access your dashboard.</p>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="space-y-5">
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
      </div>

      <div>
        <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.password_field :password, autocomplete: "current-password",
              class: "w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
      </div>

      <div class="flex items-center justify-between">
        <label class="flex items-center gap-2 text-sm text-gray-500 cursor-pointer">
          <%= f.check_box :remember_me, class: "rounded border-gray-300" %>
          Remember me
        </label>
        <%= link_to "Forgot password?", new_user_password_path, class: "text-sm text-gray-500 hover:text-gray-900" %>
      </div>

      <%= f.submit "Sign in", class: "w-full bg-gray-900 text-white hover:bg-gray-700 px-5 py-2.5 rounded-lg text-sm font-semibold transition-colors cursor-pointer" %>
    </div>
  <% end %>
</div>

<% if flash[:alert] %>
  <p class="mt-4 text-center text-sm text-gray-500"><%= flash[:alert] %></p>
<% end %>

<p class="mt-8 text-center">
  <%= link_to "Back to homepage", public_root_path, class: "text-sm text-gray-400 hover:text-gray-900" %>
</p>
