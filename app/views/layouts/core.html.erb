<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Northbolt Dashboard" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-gray-50 text-gray-900 antialiased"
        data-controller="nav notifications support"
        data-notifications-url-value="<%= core_notifications_path %>"
        data-notifications-unread-count-url-value="<%= core_notifications_unread_count_path %>">

    <!-- Mobile top bar -->
    <div class="lg:hidden fixed top-0 inset-x-0 z-40 h-14 bg-white border-b border-gray-200 flex items-center px-4">
      <button data-action="nav#open" class="text-gray-500 hover:text-gray-900 p-1 shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
      <div class="absolute left-1/2 -translate-x-1/2">
        <%= render "shared/logo", size: :sm, text_size: "text-base" %>
      </div>
      <div class="ml-auto shrink-0">
        <%= render "core/notifications/bell" %>
      </div>
    </div>

    <!-- Backdrop -->
    <div data-nav-target="backdrop"
         data-action="click->nav#close"
         class="hidden fixed inset-0 z-40 bg-gray-900/40 lg:hidden">
    </div>

    <!-- Sidebar -->
    <aside data-nav-target="sidebar"
           class="fixed inset-y-0 left-0 z-50 w-64 bg-white border-r border-gray-200 flex flex-col -translate-x-full lg:translate-x-0 transition-transform duration-200">

      <!-- Logo -->
      <div class="h-16 flex items-center px-6 border-b border-gray-200 shrink-0">
        <%= render "shared/logo" %>
      </div>

      <!-- Nav links -->
      <nav class="flex-1 px-3 py-4 space-y-0.5 overflow-y-auto">
        <%= link_to core_dashboard_path,
              class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium #{request.path == core_dashboard_path ? 'bg-gray-100 text-gray-900' : 'text-gray-500 hover:bg-gray-50 hover:text-gray-900'}" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Dashboard
        <% end %>

<%= link_to core_locks_path,
              class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium #{request.path.start_with?(core_locks_path) ? 'bg-gray-100 text-gray-900' : 'text-gray-500 hover:bg-gray-50 hover:text-gray-900'}" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          Locks
        <% end %>

        <%= link_to core_tenants_path,
              class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium #{request.path.start_with?(core_tenants_path) ? 'bg-gray-100 text-gray-900' : 'text-gray-500 hover:bg-gray-50 hover:text-gray-900'}" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          Tenants
        <% end %>

        <%= link_to core_activity_path,
              class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium #{request.path.start_with?(core_activity_path) ? 'bg-gray-100 text-gray-900' : 'text-gray-500 hover:bg-gray-50 hover:text-gray-900'}" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          </svg>
          Activity
        <% end %>

        <%= link_to core_billing_path,
              class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium #{request.path.start_with?(core_billing_path) ? 'bg-gray-100 text-gray-900' : 'text-gray-500 hover:bg-gray-50 hover:text-gray-900'}" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
          </svg>
          Billing
        <% end %>

        <%= link_to core_settings_path,
              class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium #{request.path.start_with?(core_settings_path) ? 'bg-gray-100 text-gray-900' : 'text-gray-500 hover:bg-gray-50 hover:text-gray-900'}" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          Settings
        <% end %>
      </nav>

      <!-- User dropdown -->
      <div class="px-4 py-4 border-t border-gray-200 shrink-0 relative" data-controller="dropdown" data-action="click@window->dropdown#close">
        <button data-action="dropdown#toggle"
                class="w-full flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-50 text-left">
          <div class="w-7 h-7 rounded-full bg-gray-900 text-white flex items-center justify-center text-xs font-semibold shrink-0">
            <%= current_user.first_name.first.upcase %><%= current_user.last_name.first.upcase %>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-gray-900 truncate"><%= current_user.first_name %> <%= current_user.last_name %></p>
            <p class="text-xs text-gray-400 truncate"><%= current_user.email %></p>
          </div>
          <svg data-dropdown-target="chevron" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400 shrink-0 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
          </svg>
        </button>

        <div data-dropdown-target="menu" class="hidden absolute bottom-full left-4 right-4 mb-2 bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
          <%= link_to core_account_path, class: "flex items-center gap-3 px-4 py-2.5 text-sm text-gray-500 hover:bg-gray-50 hover:text-gray-900" do %>
            Account settings
          <% end %>
          <%= link_to "/api-docs", class: "flex items-center gap-3 px-4 py-2.5 text-sm text-gray-500 hover:bg-gray-50 hover:text-gray-900" do %>
            Developers
          <% end %>
          <div class="border-t border-gray-100"></div>
          <%= button_to "Sign out", destroy_user_session_path, method: :delete,
                class: "w-full flex items-center gap-3 px-4 py-2.5 text-sm text-gray-500 hover:bg-gray-50 hover:text-gray-900 text-left" %>
        </div>
      </div>
    </aside>

    <!-- Main content -->
    <main class="lg:pl-64 pt-14 lg:pt-0 min-h-screen">
      <header class="hidden lg:flex sticky top-0 z-30 bg-white border-b border-gray-200 h-16 items-center justify-end gap-1 px-6">
        <%# Support button %>
        <button data-action="support#open"
                class="relative p-2 text-gray-400 hover:text-gray-900 rounded-lg hover:bg-gray-100 transition-colors"
                title="Help & support">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </button>
        <%= render "core/notifications/bell" %>
      </header>
      <div class="p-6">
        <%= render "shared/flash" %>
        <%= yield %>
      </div>
    </main>


    <!-- Notifications backdrop -->
    <div data-notifications-target="backdrop"
         data-action="click->notifications#close"
         class="hidden fixed inset-0 z-60 bg-gray-900/40">
    </div>

    <!-- Notifications drawer -->
    <div data-notifications-target="drawer"
         class="fixed inset-y-0 right-0 z-70 w-full sm:w-96 bg-white border-l border-gray-200 shadow-xl flex flex-col translate-x-full transition-transform duration-300">

      <div class="flex items-center justify-between px-4 py-4 border-b border-gray-100 shrink-0">
        <h2 class="text-sm font-semibold text-gray-900">Notifications</h2>
        <button data-action="notifications#close" class="p-1 text-gray-400 hover:text-gray-900 rounded-lg hover:bg-gray-100 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="flex-1 overflow-y-auto">
        <turbo-frame id="notifications_frame" src="<%= core_notifications_path %>">
          <div class="p-4 text-sm text-gray-400 text-center">Loading...</div>
        </turbo-frame>
      </div>

    </div>

    <!-- Support backdrop -->
    <div data-support-target="backdrop"
         data-action="click->support#close"
         class="hidden fixed inset-0 z-60 bg-gray-900/40">
    </div>

    <!-- Support drawer -->
    <div data-support-target="drawer"
         class="fixed inset-y-0 right-0 z-70 w-full sm:w-96 bg-white border-l border-gray-200 shadow-xl flex flex-col translate-x-full transition-transform duration-300">

      <%# Header %>
      <div class="flex items-center justify-between px-4 py-4 border-b border-gray-100 shrink-0">
        <div class="flex items-center gap-2">
          <button data-support-target="backButton"
                  data-action="support#showArticles"
                  class="hidden p-1 -ml-1 text-gray-400 hover:text-gray-900 rounded-lg hover:bg-gray-100 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <h2 data-support-target="drawerTitle" class="text-sm font-semibold text-gray-900">Help & support</h2>
        </div>
        <button data-action="support#close" class="p-1 text-gray-400 hover:text-gray-900 rounded-lg hover:bg-gray-100 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <%# Articles view %>
      <div data-support-target="articlesView" class="flex flex-col flex-1 min-h-0">
        <div class="flex-1 overflow-y-auto">
          <div class="p-4 space-y-4">

            <% if flash[:support_notice] %>
              <div class="bg-green-50 border border-green-200 rounded-lg px-4 py-3 text-sm text-green-800"><%= flash[:support_notice] %></div>
            <% end %>

            <%# Search %>
            <div class="relative">
              <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <input type="text"
                     data-support-target="search"
                     data-action="input->support#search"
                     placeholder="Search articles…"
                     class="w-full pl-9 pr-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent">
            </div>

            <%# Articles %>
            <div class="space-y-1">
              <%
                articles = [
                  { title: "Getting started with Northbolt",    desc: "Set up your first lock and grant tenant access" },
                  { title: "How to grant a tenant access",       desc: "Issue a PIN and set access dates" },
                  { title: "How to revoke access",               desc: "Remove a tenant's access before their lease ends" },
                  { title: "What to do if a lock goes offline",  desc: "Troubleshooting cellular and connectivity issues" },
                  { title: "Low battery — what to do",           desc: "When to act and how to replace the battery" },
                  { title: "Managing your team",                 desc: "Invite members and set permission levels" },
                ]
              %>
              <% articles.each do |article| %>
                <div data-support-target="article" data-title="<%= article[:title].downcase %>"
                     class="flex items-start gap-3 px-3 py-3 rounded-lg hover:bg-gray-50 cursor-pointer group">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mt-0.5 shrink-0 text-gray-400 group-hover:text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                  <div>
                    <p class="text-sm font-medium text-gray-900"><%= article[:title] %></p>
                    <p class="text-xs text-gray-400 mt-0.5"><%= article[:desc] %></p>
                  </div>
                </div>
              <% end %>
            </div>

          </div>
        </div>

        <%# Fixed bottom CTA %>
        <div class="shrink-0 p-4 border-t border-gray-100">
          <button data-action="support#showContact"
                  class="w-full px-4 py-2.5 text-sm font-medium text-white bg-gray-900 rounded-lg hover:bg-gray-700 transition-colors cursor-pointer">
            Contact support
          </button>
        </div>
      </div>

      <%# Contact form view %>
      <div data-support-target="contactView" class="hidden flex-col flex-1 min-h-0">
        <div class="flex-1 overflow-y-auto">
          <div class="p-4">
            <% if flash[:support_alert] %>
              <div class="mb-4 bg-red-50 border border-red-200 rounded-lg px-4 py-3 text-sm text-red-700"><%= flash[:support_alert] %></div>
            <% end %>
            <%= form_with url: core_support_tickets_path, method: :post, class: "space-y-4" do |f| %>
              <div>
                <label class="block text-xs font-medium text-gray-700 mb-1.5">From</label>
                <input type="text" value="<%= "#{current_user.first_name} #{current_user.last_name} (#{current_user.email})" %>" disabled
                       class="w-full text-sm border border-gray-100 rounded-lg px-3 py-2.5 text-gray-400 bg-gray-50 cursor-not-allowed">
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-700 mb-1.5">Subject</label>
                <input type="text" name="subject" required
                       class="w-full text-sm border border-gray-200 rounded-lg px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent">
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-700 mb-1.5">Message</label>
                <textarea name="message" rows="6" required
                          class="w-full text-sm border border-gray-200 rounded-lg px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent resize-none"></textarea>
              </div>
              <%= f.submit "Send message",
                    class: "w-full px-4 py-2.5 text-sm font-medium text-white bg-gray-900 rounded-lg hover:bg-gray-700 transition-colors cursor-pointer" %>
            <% end %>
          </div>
        </div>
      </div>

    </div>

  </body>
</html>
