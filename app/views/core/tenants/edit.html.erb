<% content_for :title, "Edit #{@tenant.full_name}" %>

<div class="max-w-3xl mx-auto space-y-6">

  <div class="flex items-center gap-3">
    <%= link_to core_tenant_path(@tenant), class: "text-gray-400 hover:text-gray-900 transition-colors" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    <% end %>
    <h1 class="text-lg font-semibold text-gray-900">Edit tenant</h1>
  </div>

  <%= form_with model: [:core, @tenant], class: "space-y-6" do |f| %>

    <div class="bg-white border border-gray-200 rounded-xl divide-y divide-gray-100">
      <div class="px-4 py-3 grid grid-cols-2 gap-3">
        <% [:first_name, :last_name].each do |attr| %>
          <div class="space-y-1">
            <%= f.label attr, class: "block text-xs font-medium text-gray-500" %>
            <%= f.text_field attr, autocomplete: "off",
                  class: "w-full px-3 py-2 text-sm border rounded-lg bg-white focus:outline-none focus:ring-2 focus:border-transparent #{@tenant.errors[attr].any? ? 'border-red-400 focus:ring-red-400' : 'border-gray-200 focus:ring-gray-900'}" %>
            <% if @tenant.errors[attr].any? %>
              <p class="text-xs text-red-600"><%= @tenant.errors[attr].first %></p>
            <% end %>
          </div>
        <% end %>
      </div>
      <div class="px-4 py-3 space-y-1">
        <%= f.label :email, class: "block text-xs font-medium text-gray-500" %>
        <%= f.email_field :email, autocomplete: "off",
              class: "w-full px-3 py-2 text-sm border rounded-lg bg-white focus:outline-none focus:ring-2 focus:border-transparent #{@tenant.errors[:email].any? ? 'border-red-400 focus:ring-red-400' : 'border-gray-200 focus:ring-gray-900'}" %>
        <% if @tenant.errors[:email].any? %>
          <p class="text-xs text-red-600"><%= @tenant.errors[:email].first %></p>
        <% end %>
      </div>
      <div class="px-4 py-3 space-y-1">
        <%= f.label :phone, class: "block text-xs font-medium text-gray-500" %>
        <%= f.telephone_field :phone, autocomplete: "off",
              class: "w-full px-3 py-2 text-sm border rounded-lg bg-white focus:outline-none focus:ring-2 focus:border-transparent #{@tenant.errors[:phone].any? ? 'border-red-400 focus:ring-red-400' : 'border-gray-200 focus:ring-gray-900'}" %>
        <% if @tenant.errors[:phone].any? %>
          <p class="text-xs text-red-600"><%= @tenant.errors[:phone].first %></p>
        <% end %>
      </div>
    </div>

    <div class="flex items-center justify-between">
      <%= button_to "Delete #{@tenant.first_name}", core_tenant_path(@tenant), method: :delete,
            class: "px-4 py-2 text-sm font-medium text-red-600 hover:text-red-700 transition-colors",
            form: { data: { turbo_confirm: "Delete #{@tenant.full_name}? This cannot be undone." } } %>
      <div class="flex gap-2">
        <%= link_to "Cancel", core_tenant_path(@tenant), class: "px-4 py-2 text-sm font-medium text-gray-500 hover:text-gray-900 transition-colors" %>
        <%= f.submit "Save changes", class: "px-4 py-2 text-sm font-medium bg-gray-900 text-white rounded-lg hover:bg-gray-700 transition-colors cursor-pointer" %>
      </div>
    </div>

  <% end %>

</div>
