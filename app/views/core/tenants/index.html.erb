<% content_for :title, "Tenants" %>

<div class="max-w-5xl mx-auto space-y-6">

  <div class="flex items-center justify-between">
    <h1 class="text-lg font-semibold text-gray-900">Tenants</h1>
    <%= link_to "Add tenant", new_core_tenant_path,
          class: "px-3 py-2 text-sm font-medium bg-gray-900 text-white rounded-lg hover:bg-gray-700 transition-colors" %>
  </div>

  <%= form_with url: core_tenants_path, method: :get, data: { controller: "search" } do |f| %>
    <div class="flex gap-2">
      <div class="relative flex-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 0 5 11a6 6 0 0 0 12 0z" />
        </svg>
        <%= f.text_field :q, value: @q,
              placeholder: "Search by name, email or phone…",
              class: "w-full pl-10 pr-10 py-2 text-sm border border-gray-200 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent",
              autocomplete: "off",
              data: { search_target: "input", action: "input->search#input" } %>
        <button type="button"
                data-search-target="clear"
                data-action="search#clear"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 <%= @q.blank? ? 'hidden' : '' %>">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <%= f.select :sort,
            [
              ["Name (A–Z)",      "name_asc"],
              ["Name (Z–A)",      "name_desc"],
              ["Newest first",    "newest"],
              ["Oldest first",    "oldest"]
            ],
            { selected: @sort },
            class: "py-2 px-3 text-sm border border-gray-200 rounded-lg bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-900 cursor-pointer",
            onchange: "this.form.requestSubmit()" %>
    </div>
  <% end %>

  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
    <% if @tenants.any? %>
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-100 bg-gray-50">
            <th class="px-4 py-3 text-left font-medium text-gray-500">Name</th>
            <th class="px-4 py-3 text-left font-medium text-gray-500 hidden sm:table-cell">Email</th>
            <th class="px-4 py-3 text-left font-medium text-gray-500 hidden md:table-cell">Phone</th>
            <th class="px-4 py-3 text-left font-medium text-gray-500 hidden md:table-cell">Locks</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @tenants.each do |tenant| %>
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-4 py-3 font-medium text-gray-900"><%= tenant.full_name %></td>
              <td class="px-4 py-3 text-gray-500 hidden sm:table-cell"><%= tenant.email %></td>
              <td class="px-4 py-3 text-gray-500 hidden md:table-cell"><%= tenant.phone %></td>
              <td class="px-4 py-3 hidden md:table-cell">
                <% active     = tenant.access_grants.count { |g| g.revoked_at.nil? && g.ends_at > Time.current } %>
                <% historical = tenant.access_grants.count { |g| g.revoked_at.present? || g.ends_at <= Time.current } %>
                <% if active > 0 %>
                  <span class="text-xs font-medium text-green-600"><%= active %> active</span>
                <% elsif historical > 0 %>
                  <span class="text-xs text-gray-400"><%= historical %> historical</span>
                <% else %>
                  <span class="text-xs text-gray-400">None</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-right">
                <%= link_to "View", core_tenant_path(tenant), class: "text-xs font-medium text-gray-500 hover:text-gray-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <% if @tenants.total_pages > 1 %>
        <div class="px-4 py-3 border-t border-gray-100 flex items-center justify-between text-sm text-gray-500">
          <span><%= @tenants.offset_value + 1 %>–<%= [@tenants.offset_value + @tenants.limit_value, @tenants.total_count].min %> of <%= @tenants.total_count %></span>
          <div class="flex gap-1">
            <% unless @tenants.first_page? %>
              <%= link_to "← Previous", core_tenants_path(page: @tenants.prev_page, q: @q, sort: @sort),
                    class: "px-3 py-1 rounded-lg border border-gray-200 hover:bg-gray-50 transition-colors" %>
            <% end %>
            <% unless @tenants.last_page? %>
              <%= link_to "Next →", core_tenants_path(page: @tenants.next_page, q: @q, sort: @sort),
                    class: "px-3 py-1 rounded-lg border border-gray-200 hover:bg-gray-50 transition-colors" %>
            <% end %>
          </div>
        </div>
      <% end %>

    <% else %>
      <div class="px-4 py-12 text-center text-sm text-gray-400">
        <% if @q.present? %>
          No tenants found matching "<%= @q %>"
        <% else %>
          No tenants yet.
        <% end %>
      </div>
    <% end %>
  </div>

</div>
