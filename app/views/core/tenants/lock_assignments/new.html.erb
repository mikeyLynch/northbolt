<% content_for :title, "Assign locks — #{@tenant.full_name}" %>

<div class="max-w-3xl mx-auto space-y-6">

  <div class="flex items-center gap-3">
    <%= link_to core_tenant_path(@tenant), class: "text-gray-400 hover:text-gray-900 transition-colors" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    <% end %>
    <h1 class="text-lg font-semibold text-gray-900">Assign locks — <%= @tenant.full_name %></h1>
  </div>

  <%= form_with url: core_tenant_lock_assignments_path(@tenant),
        class: "space-y-6",
        data: {
          controller: "lock-picker",
          lock_picker_locks_value: @available_locks.map { |l| { id: l.id, unit_identifier: l.unit_identifier, location_name: l.location.name } }.to_json,
          lock_picker_auto_row_value: true,
          action: "submit->lock-picker#interceptSubmit"
        } do %>

    <input type="hidden" name="pin_mode" value="individual" data-lock-picker-target="pinModeInput">

    <div class="bg-white border border-gray-200 rounded-xl">

      <div class="px-4 py-3 flex items-center justify-between">
        <h2 class="text-sm font-medium text-gray-900">Locks</h2>
        <% if @available_locks.any? %>
          <button type="button"
                  data-action="lock-picker#addRow"
                  class="text-sm font-medium text-gray-500 hover:text-gray-900 transition-colors">
            + Add lock
          </button>
        <% else %>
          <span class="text-xs text-gray-400">All locks have active tenants</span>
        <% end %>
      </div>

      <div data-lock-picker-target="rows"></div>

      <template data-lock-picker-target="template">
        <div class="px-4 py-3 border-t border-gray-100 flex gap-2 items-end" data-lock-picker-row>
          <div class="relative flex-1 min-w-0">
            <div class="space-y-1">
              <p class="text-xs font-medium text-gray-500">Lock</p>
              <input type="text"
                     placeholder="Search by unit or location…"
                     autocomplete="off"
                     data-lock-search
                     data-action="input->lock-picker#filter focus->lock-picker#filter"
                     class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent">
            </div>
            <input type="hidden" name="lock_assignments[INDEX][lock_id]" data-lock-id-input>
            <div data-lock-dropdown
                 class="hidden absolute z-10 top-full mt-1 left-0 right-0 bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
            </div>
          </div>
          <div class="space-y-1 shrink-0">
            <p class="text-xs font-medium text-gray-500">From</p>
            <input type="date"
                   name="lock_assignments[INDEX][starts_at]"
                   value="<%= Date.current.iso8601 %>"
                   class="px-3 py-2 text-sm border border-gray-200 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent">
          </div>
          <div class="space-y-1 shrink-0">
            <p class="text-xs font-medium text-gray-500">Until</p>
            <input type="date"
                   name="lock_assignments[INDEX][ends_at]"
                   required
                   class="px-3 py-2 text-sm border border-gray-200 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent">
          </div>
          <button type="button"
                  data-action="lock-picker#removeRow"
                  class="p-1.5 text-gray-400 hover:text-gray-700 rounded-lg hover:bg-gray-100 transition-colors shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </template>

    </div>

    <div class="flex gap-2 justify-end">
      <%= link_to "Cancel", core_tenant_path(@tenant), class: "px-4 py-2 text-sm font-medium text-gray-500 hover:text-gray-900 transition-colors" %>
      <button type="submit" class="px-4 py-2 text-sm font-medium bg-gray-900 text-white rounded-lg hover:bg-gray-700 transition-colors">
        Assign locks
      </button>
    </div>

    <!-- PIN mode modal -->
    <div data-lock-picker-target="modal"
         class="hidden fixed inset-0 z-50 bg-gray-900/50">
      <div class="flex items-center justify-center h-full px-4">
        <div class="bg-white rounded-xl shadow-xl p-6 max-w-sm w-full space-y-4">
          <div class="space-y-1">
            <h3 class="text-sm font-semibold text-gray-900">PIN assignment</h3>
            <p class="text-sm text-gray-500">Issue one PIN that works across all assigned locks, or a separate PIN for each?</p>
          </div>
          <div class="flex flex-col gap-2">
            <button type="button"
                    data-action="lock-picker#choosePinMode"
                    data-mode="shared"
                    class="w-full px-4 py-2.5 text-sm font-medium bg-gray-900 text-white rounded-lg hover:bg-gray-700 transition-colors">
              One PIN for all locks
            </button>
            <button type="button"
                    data-action="lock-picker#choosePinMode"
                    data-mode="individual"
                    class="w-full px-4 py-2.5 text-sm font-medium border border-gray-200 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors">
              Individual PIN per lock
            </button>
          </div>
        </div>
      </div>
    </div>

  <% end %>

</div>
