<% content_for :title, "Edit access grant — Unit #{@grant.lock.unit_identifier}" %>

<div class="max-w-lg mx-auto space-y-6">

  <div class="flex items-center gap-3">
    <%= link_to (@return_to || core_lock_path(@grant.lock)), class: "text-gray-400 hover:text-gray-900 transition-colors" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    <% end %>
    <h1 class="text-lg font-semibold text-gray-900">Edit access grant</h1>
  </div>

  <%= form_with url: core_access_grant_path(@grant), method: :patch, scope: :access_grant, class: "space-y-6" do |f| %>
    <input type="hidden" name="return_to" value="<%= @return_to %>">

    <div class="bg-white border border-gray-200 rounded-xl divide-y divide-gray-100">
      <div class="px-4 py-3 flex items-center justify-between">
        <span class="text-sm text-gray-500">Tenant</span>
        <span class="text-sm font-medium text-gray-900"><%= @grant.tenant.full_name %></span>
      </div>
      <div class="px-4 py-3 flex items-center justify-between">
        <span class="text-sm text-gray-500">Lock</span>
        <span class="text-sm text-gray-900">Unit <%= @grant.lock.unit_identifier %> — <%= @grant.lock.location.name %></span>
      </div>
      <div class="px-4 py-4 grid grid-cols-2 gap-3">
        <div class="space-y-1">
          <%= f.label :starts_at, "From", class: "block text-sm font-medium text-gray-700" %>
          <%= f.date_field :starts_at, value: @grant.starts_at.to_date,
                class: "w-full py-2 px-3 text-sm border border-gray-200 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
        </div>
        <div class="space-y-1">
          <%= f.label :ends_at, "Until", class: "block text-sm font-medium text-gray-700" %>
          <%= f.date_field :ends_at, value: @grant.ends_at.to_date,
                class: "w-full py-2 px-3 text-sm border border-gray-200 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
        </div>
      </div>
    </div>

    <div class="flex justify-end gap-2">
      <%= link_to "Cancel", (@return_to || core_lock_path(@grant.lock)),
            class: "px-4 py-2 text-sm font-medium text-gray-500 hover:text-gray-900 transition-colors" %>
      <button type="submit" class="px-4 py-2 text-sm font-medium bg-gray-900 text-white rounded-lg hover:bg-gray-700 transition-colors">
        Save changes
      </button>
    </div>
  <% end %>

  <% unless @grant.revoked? || @grant.ends_at <= Time.current %>
    <hr class="border-gray-200">
    <div class="bg-white border border-gray-200 rounded-xl px-4 py-4 flex items-center justify-between gap-4">
      <div>
        <p class="text-sm font-medium text-gray-900">Revoke access</p>
        <p class="text-xs text-gray-500 mt-0.5">Immediately removes the tenant's access to this lock.</p>
      </div>
      <%= button_to "Revoke access", revoke_core_access_grant_path(@grant),
            method: :patch,
            params: { return_to: @return_to },
            class: "px-3 py-2 text-sm font-medium text-red-600 border border-red-200 rounded-lg hover:bg-red-50 transition-colors shrink-0",
            data: { turbo_confirm: "Revoke #{@grant.tenant.full_name}'s access to Unit #{@grant.lock.unit_identifier}? This cannot be undone." } %>
    </div>
  <% end %>

</div>
