<% content_for :title, "Billing" %>

<div class="max-w-3xl mx-auto space-y-6">

  <h1 class="text-lg font-semibold text-gray-900">Billing</h1>

  <%# Stat panels %>
  <% service_active = @active_service&.service_period_end&.>=(Date.current) %>
  <div class="grid grid-cols-2 gap-4">

    <%# Locks + service status %>
    <div class="bg-white border border-gray-200 rounded-xl px-6 py-5">
      <p class="text-xs font-medium text-gray-400 uppercase tracking-widest">Locks registered</p>
      <p class="text-3xl font-bold text-gray-900 mt-2"><%= @business.locks.count %></p>
      <div class="mt-3 pt-3 border-t border-gray-100">
        <% if service_active %>
          <span class="inline-flex items-center gap-1.5 text-xs font-medium text-green-700">
            <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>Service active
          </span>
        <% else %>
          <span class="inline-flex items-center gap-1.5 text-xs font-medium text-gray-400">
            <span class="w-1.5 h-1.5 rounded-full bg-gray-300"></span>No active service
          </span>
        <% end %>
      </div>
    </div>

    <%# Next renewal %>
    <div class="bg-white border border-gray-200 rounded-xl px-6 py-5">
      <p class="text-xs font-medium text-gray-400 uppercase tracking-widest">Next renewal</p>
      <% if @active_service&.service_period_end %>
        <p class="text-3xl font-bold text-gray-900 mt-2"><%= @active_service.service_period_end.strftime("%-d %b %Y") %></p>
        <div class="mt-3 pt-3 border-t border-gray-100">
          <p class="text-xs text-gray-400"><%= format("£%.2f", Invoice::SERVICE_ANNUAL_PENCE_PER_LOCK * @business.locks.count / 100.0) %>/year</p>
        </div>
      <% else %>
        <p class="text-3xl font-bold text-gray-300 mt-2">—</p>
        <div class="mt-3 pt-3 border-t border-gray-100">
          <p class="text-xs text-gray-400">No service invoice on record</p>
        </div>
      <% end %>
    </div>

  </div>

  <%# Payment details %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100">
      <h2 class="text-sm font-semibold text-gray-900">How to pay</h2>
    </div>
    <div class="px-6 py-5 space-y-4">
      <p class="text-sm text-gray-500">All invoices are payable by BACS transfer. Please use your invoice number as the payment reference so we can match your payment.</p>
      <div class="grid grid-cols-2 gap-x-8 gap-y-3">
        <div>
          <p class="text-xs font-medium text-gray-400 uppercase tracking-widest">Account name</p>
          <p class="text-sm font-medium text-gray-900 mt-1"><%= Invoice::COMPANY_NAME %></p>
        </div>
        <div>
          <p class="text-xs font-medium text-gray-400 uppercase tracking-widest">Bank</p>
          <p class="text-sm font-medium text-gray-900 mt-1">Stub Bank plc</p>
        </div>
        <div>
          <p class="text-xs font-medium text-gray-400 uppercase tracking-widest">Sort code</p>
          <p class="text-sm font-medium text-gray-900 mt-1">00-00-00</p>
        </div>
        <div>
          <p class="text-xs font-medium text-gray-400 uppercase tracking-widest">Account number</p>
          <p class="text-sm font-medium text-gray-900 mt-1">00000000</p>
        </div>
      </div>
    </div>
  </div>

  <%# Invoice history %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100">
      <h2 class="text-sm font-semibold text-gray-900">Invoices</h2>
    </div>
    <% if @invoices.any? %>
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-100 bg-gray-50">
            <th class="px-4 py-3 text-left font-medium text-gray-500">Invoice</th>
            <th class="px-4 py-3 text-left font-medium text-gray-500 hidden sm:table-cell">Type</th>
            <th class="px-4 py-3 text-left font-medium text-gray-500 hidden sm:table-cell">Issued</th>
            <th class="px-4 py-3 text-left font-medium text-gray-500">Amount</th>
            <th class="px-4 py-3 text-left font-medium text-gray-500">Status</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @invoices.each do |invoice| %>
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-4 py-3 font-medium text-gray-900"><%= invoice.number %></td>
              <td class="px-4 py-3 text-gray-500 hidden sm:table-cell capitalize">
                <%= invoice.category %>
                <% if invoice.installment_deposit? %><span class="text-gray-400">(deposit)</span>
                <% elsif invoice.installment_delivery? %><span class="text-gray-400">(delivery)</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-gray-500 hidden sm:table-cell">
                <%= invoice.issued_at&.strftime("%-d %b %Y") || "—" %>
              </td>
              <td class="px-4 py-3 text-gray-900"><%= invoice.formatted_total %></td>
              <td class="px-4 py-3">
                <% case invoice.status %>
                <% when "draft" %>
                  <span class="text-xs font-medium text-gray-400">Draft</span>
                <% when "outstanding" %>
                  <span class="text-xs font-medium text-amber-600">Outstanding</span>
                <% when "paid" %>
                  <span class="text-xs font-medium text-green-600">Paid</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-right">
                <% if invoice.outstanding? || invoice.paid? %>
                  <%= link_to "Download", core_billing_invoice_download_path(invoice),
                        class: "text-xs font-medium text-gray-500 hover:text-gray-900 hover:underline" %>
                <% end %>
                <% if invoice.refunds.any? %>
                  <span class="ml-2 text-xs text-red-500">Refunded <%= format("£%.2f", invoice.refunded_pence / 100.0) %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="px-4 py-12 text-center text-sm text-gray-400">No invoices yet.</div>
    <% end %>
  </div>

</div>
