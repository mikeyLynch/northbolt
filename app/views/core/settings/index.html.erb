<% content_for :title, "Settings" %>

<div class="max-w-3xl mx-auto space-y-6">

  <h1 class="text-lg font-semibold text-gray-900">Settings</h1>

  <turbo-frame id="settings_tab">
    <div class="space-y-6">
      <div class="flex gap-1 border-b border-gray-200">
        <%= link_to "General", core_settings_path(tab: "general"),
              class: "px-4 py-2 text-sm font-medium border-b-2 transition-colors #{@tab == 'general' ? 'border-gray-900 text-gray-900' : 'border-transparent text-gray-500 hover:text-gray-900'}",
              data: { turbo_frame: "settings_tab", turbo_action: "advance" } %>
        <%= link_to "API keys", core_settings_path(tab: "api_keys"),
              class: "px-4 py-2 text-sm font-medium border-b-2 transition-colors #{@tab == 'api_keys' ? 'border-gray-900 text-gray-900' : 'border-transparent text-gray-500 hover:text-gray-900'}",
              data: { turbo_frame: "settings_tab", turbo_action: "advance" } %>
        <%= link_to "Integrations", core_settings_path(tab: "integrations"),
              class: "px-4 py-2 text-sm font-medium border-b-2 transition-colors #{@tab == 'integrations' ? 'border-gray-900 text-gray-900' : 'border-transparent text-gray-500 hover:text-gray-900'}",
              data: { turbo_frame: "settings_tab", turbo_action: "advance" } %>
        <%= link_to "Team", core_settings_path(tab: "team"),
              class: "px-4 py-2 text-sm font-medium border-b-2 transition-colors #{@tab == 'team' ? 'border-gray-900 text-gray-900' : 'border-transparent text-gray-500 hover:text-gray-900'}",
              data: { turbo_frame: "settings_tab", turbo_action: "advance" } %>
        <%= link_to "Permissions", core_settings_path(tab: "permissions"),
              class: "px-4 py-2 text-sm font-medium border-b-2 transition-colors #{@tab == 'permissions' ? 'border-gray-900 text-gray-900' : 'border-transparent text-gray-500 hover:text-gray-900'}",
              data: { turbo_frame: "settings_tab", turbo_action: "advance" } %>
        <%= link_to "Locations", core_settings_path(tab: "locations"),
              class: "px-4 py-2 text-sm font-medium border-b-2 transition-colors #{@tab == 'locations' ? 'border-gray-900 text-gray-900' : 'border-transparent text-gray-500 hover:text-gray-900'}",
              data: { turbo_frame: "settings_tab", turbo_action: "advance" } %>
      </div>

      <% if @tab == "integrations" %>
        <%= render "core/settings/integrations" %>
      <% elsif @tab == "api_keys" %>
        <%= render "core/settings/api_keys" %>
      <% elsif @tab == "team" %>
        <%= render "core/settings/team" %>
      <% elsif @tab == "permissions" %>
        <%= render "core/settings/permissions" %>
      <% elsif @tab == "locations" %>
        <%= render "core/settings/locations" %>
      <% else %>
        <%= render "core/settings/general" %>
      <% end %>
    </div>
  </turbo-frame>

</div>
