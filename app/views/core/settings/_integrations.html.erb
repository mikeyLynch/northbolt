<div class="space-y-4">

  <%# Stora %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-3">
      <div>
        <h2 class="text-sm font-semibold text-gray-900">Stora</h2>
        <p class="text-xs text-gray-500">Automatically issue and revoke access when tenants book or cancel on Stora.</p>
      </div>
      <% if @business.stora_configured? %>
        <span class="ml-auto text-xs font-medium text-green-600 bg-green-50 border border-green-100 rounded-full px-2.5 py-0.5">Connected</span>
      <% else %>
        <span class="ml-auto text-xs font-medium text-gray-400 bg-gray-50 border border-gray-200 rounded-full px-2.5 py-0.5">Not connected</span>
      <% end %>
    </div>

    <div class="px-6">
      <% if @business.stora_webhook_token.present? %>
        <div class="space-y-1.5 py-2">
          <label class="block text-xs font-medium text-gray-500">Webhook URL</label>
          <div class="flex items-center gap-2">
            <code class="flex-1 block text-xs bg-gray-50 border border-gray-200 rounded-lg px-3 py-2 text-gray-700 break-all select-all">
              <%= webhooks_stora_url(token: @business.stora_webhook_token) %>
            </code>
          </div>
          <p class="text-xs text-gray-400">Paste this URL into the Webhooks section of your Stora account.</p>
        </div>
      <% end %>

      <%= form_with url: core_settings_stora_path, method: :patch, class: "space-y-4 pt-2 mb-4", data: { turbo_frame: "settings_tab" } do |f| %>
        <div class="space-y-1.5">
          <label for="stora_webhook_secret" class="block text-xs font-medium text-gray-500">
            Signing secret
          </label>
          <input
            type="password"
            id="stora_webhook_secret"
            name="stora_webhook_secret"
            placeholder="Paste your Stora signing secret…"
            autocomplete="off"
            class="block w-full text-sm border border-gray-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent"
          >
          <p class="text-xs text-gray-400">Found in Stora → Settings → Webhooks → Signing secret. Used to verify that webhooks come from Stora.</p>
        </div>

        <%= f.submit @business.stora_webhook_token.present? ? "Save changes" : "Connect Stora",
              class: "px-4 py-2 text-sm font-medium text-white bg-gray-900 rounded-lg hover:bg-gray-700 transition-colors cursor-pointer" %>
      <% end %>
    </div>
  </div>

</div>
