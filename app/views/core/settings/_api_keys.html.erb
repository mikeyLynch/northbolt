<div class="space-y-4">

  <%# New token reveal — shown once after creation %>
  <% if flash[:new_token] %>
    <div class="bg-green-50 border border-green-200 rounded-xl px-5 py-4 space-y-2">
      <p class="text-sm font-medium text-green-800">API key created — copy it now. It won't be shown again.</p>
      <code class="block text-xs bg-white border border-green-200 rounded-lg px-3 py-2 text-gray-800 break-all select-all"><%= flash[:new_token] %></code>
    </div>
  <% end %>

  <%# Create form %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100">
      <h2 class="text-sm font-semibold text-gray-900">New API key</h2>
      <p class="text-xs text-gray-500 mt-0.5">Give the key a name so you know what it's used for.</p>
    </div>
    <div class="px-6 py-6">
      <%= form_with url: core_settings_api_keys_path, method: :post, class: "flex gap-3" do |f| %>
        <input
          type="text"
          name="api_key_name"
          placeholder="e.g. Production"
          required
          class="flex-1 text-sm border border-gray-200 rounded-lg px-3 py-3 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent"
        >
        <%= f.submit "Create key",
              class: "px-4 py-3 text-sm font-medium text-white bg-gray-900 rounded-lg hover:bg-gray-700 transition-colors cursor-pointer shrink-0" %>
      <% end %>
    </div>
  </div>

  <%# Existing keys %>
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100">
      <h2 class="text-sm font-semibold text-gray-900">Active keys</h2>
    </div>
    <% active_keys = @api_keys.select(&:active?) %>
    <% if active_keys.any? %>
      <ul class="divide-y divide-gray-100">
        <% active_keys.each do |key| %>
          <li class="px-6 py-4 flex items-center justify-between gap-4">
            <div class="space-y-0.5 min-w-0">
              <p class="text-sm font-medium text-gray-900"><%= key.name %></p>
              <p class="text-xs text-gray-400">
                Created <%= key.created_at.strftime("%-d %b %Y") %>
                <% if key.last_used_at %>
                  · Last used <%= time_ago_in_words(key.last_used_at) %> ago
                <% else %>
                  · Never used
                <% end %>
              </p>
            </div>
            <%= button_to "Revoke", core_settings_api_key_path(key),
                  method: :delete,
                  class: "text-xs font-medium text-red-600 hover:text-red-700 transition-colors cursor-pointer shrink-0",
                  form: { data: { turbo_confirm: %(Revoke "#{key.name}"? This can't be undone.) } } %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="px-6 py-8 text-sm text-center text-gray-400">No active API keys.</p>
    <% end %>

    <% revoked_keys = @api_keys.reject(&:active?) %>
    <% if revoked_keys.any? %>
      <div class="border-t border-gray-100">
        <div class="px-6 py-3">
          <p class="text-xs font-medium text-gray-400 uppercase tracking-widest">Revoked</p>
        </div>
        <ul class="divide-y divide-gray-100">
          <% revoked_keys.each do |key| %>
            <li class="px-6 py-4 flex items-center justify-between gap-4">
              <div class="space-y-0.5 min-w-0">
                <p class="text-sm font-medium text-gray-400 line-through"><%= key.name %></p>
                <p class="text-xs text-gray-400">Revoked <%= key.revoked_at.strftime("%-d %b %Y") %></p>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>

</div>
