<% content_for :title, "Account" %>

<div class="max-w-3xl mx-auto space-y-6">

  <h1 class="text-lg font-semibold text-gray-900">Account</h1>

  <%# Profile %>
  <%= form_with url: core_account_profile_path, method: :patch do |f| %>
    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Profile</h2>
      </div>
      <div class="px-6 py-6 space-y-5">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">First name</label>
            <input type="text" name="first_name" value="<%= current_user.first_name %>" required
                   class="w-full text-sm border border-gray-200 rounded-lg px-3 py-3 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Last name</label>
            <input type="text" name="last_name" value="<%= current_user.last_name %>" required
                   class="w-full text-sm border border-gray-200 rounded-lg px-3 py-3 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent">
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Email</label>
          <input type="email" name="email" value="<%= current_user.email %>" required
                 class="w-full text-sm border border-gray-200 rounded-lg px-3 py-3 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent">
        </div>
        <%= f.submit "Save changes",
              class: "px-4 py-2.5 text-sm font-medium text-white bg-gray-900 rounded-lg hover:bg-gray-700 transition-colors cursor-pointer" %>
      </div>
    </div>
  <% end %>

  <%# Password %>
  <%= form_with url: core_account_password_path, method: :patch do |f| %>
    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden mt-6">
      <div class="px-6 py-4 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Change password</h2>
      </div>
      <div class="px-6 py-6 space-y-5">
        <% if flash[:password_alert] %>
          <div class="bg-red-50 border border-red-200 rounded-lg px-4 py-3 text-sm text-red-700"><%= flash[:password_alert] %></div>
        <% end %>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Current password</label>
          <input type="password" name="current_password" required
                 class="w-full text-sm border border-gray-200 rounded-lg px-3 py-3 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">New password</label>
          <input type="password" name="password" required minlength="8"
                 class="w-full text-sm border border-gray-200 rounded-lg px-3 py-3 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Confirm new password</label>
          <input type="password" name="password_confirmation" required minlength="8"
                 class="w-full text-sm border border-gray-200 rounded-lg px-3 py-3 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent">
        </div>
        <%= f.submit "Update password",
              class: "px-4 py-2.5 text-sm font-medium text-white bg-gray-900 rounded-lg hover:bg-gray-700 transition-colors cursor-pointer" %>
      </div>
    </div>
  <% end %>

</div>
