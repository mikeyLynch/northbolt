<% content_for :title, "Account" %>

<div class="max-w-3xl mx-auto space-y-6">

  <h1 class="text-lg font-semibold text-gray-900">Account</h1>

  <%# Profile %>
  <%= form_with url: core_account_profile_path, method: :patch do |f| %>
    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Profile</h2>
      </div>
      <div class="px-6 py-6 space-y-5">
        <div class="grid grid-cols-2 gap-4">
          <% [:first_name, :last_name].each do |attr| %>
            <div class="space-y-1.5">
              <label class="block text-sm font-medium text-gray-700"><%= attr.to_s.humanize %></label>
              <input type="text" name="<%= attr %>" value="<%= current_user.send(attr) %>"
                     class="w-full text-sm border rounded-lg px-3 py-3 focus:outline-none focus:ring-2 focus:border-transparent <%= current_user.errors[attr].any? ? 'border-red-400 focus:ring-red-400' : 'border-gray-200 focus:ring-gray-900' %>">
              <% if current_user.errors[attr].any? %>
                <p class="text-xs text-red-600"><%= current_user.errors[attr].first %></p>
              <% end %>
            </div>
          <% end %>
        </div>
        <div class="space-y-1.5">
          <label class="block text-sm font-medium text-gray-700">Email</label>
          <input type="email" name="email" value="<%= current_user.email %>"
                 class="w-full text-sm border rounded-lg px-3 py-3 focus:outline-none focus:ring-2 focus:border-transparent <%= current_user.errors[:email].any? ? 'border-red-400 focus:ring-red-400' : 'border-gray-200 focus:ring-gray-900' %>">
          <% if current_user.errors[:email].any? %>
            <p class="text-xs text-red-600"><%= current_user.errors[:email].first %></p>
          <% end %>
        </div>
        <%= f.submit "Save changes",
              class: "px-4 py-2.5 text-sm font-medium text-white bg-gray-900 rounded-lg hover:bg-gray-700 transition-colors cursor-pointer" %>
      </div>
    </div>
  <% end %>

  <%# Password %>
  <%= form_with url: core_account_password_path, method: :patch do |f| %>
    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden mt-6">
      <div class="px-6 py-4 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Change password</h2>
      </div>
      <div class="px-6 py-6 space-y-5">
        <div class="space-y-1.5">
          <label class="block text-sm font-medium text-gray-700">Current password</label>
          <input type="password" name="current_password" required
                 class="w-full text-sm border rounded-lg px-3 py-3 focus:outline-none focus:ring-2 focus:border-transparent <%= @current_password_error ? 'border-red-400 focus:ring-red-400' : 'border-gray-200 focus:ring-gray-900' %>">
          <% if @current_password_error %>
            <p class="text-xs text-red-600"><%= @current_password_error %></p>
          <% end %>
        </div>
        <div class="space-y-1.5">
          <label class="block text-sm font-medium text-gray-700">New password</label>
          <input type="password" name="password" required minlength="8"
                 class="w-full text-sm border border-gray-200 rounded-lg px-3 py-3 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent">
        </div>
        <div class="space-y-1.5">
          <label class="block text-sm font-medium text-gray-700">Confirm new password</label>
          <input type="password" name="password_confirmation" required minlength="8"
                 class="w-full text-sm border rounded-lg px-3 py-3 focus:outline-none focus:ring-2 focus:border-transparent <%= @password_confirmation_error ? 'border-red-400 focus:ring-red-400' : 'border-gray-200 focus:ring-gray-900' %>">
          <% if @password_confirmation_error %>
            <p class="text-xs text-red-600"><%= @password_confirmation_error %></p>
          <% end %>
        </div>
        <%= f.submit "Update password",
              class: "px-4 py-2.5 text-sm font-medium text-white bg-gray-900 rounded-lg hover:bg-gray-700 transition-colors cursor-pointer" %>
      </div>
    </div>
  <% end %>

</div>
