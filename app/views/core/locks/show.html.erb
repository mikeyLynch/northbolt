<% content_for :title, "Unit #{@lock.unit_identifier}" %>

<div class="max-w-3xl mx-auto space-y-6">

  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <%= link_to core_locks_path, class: "text-gray-400 hover:text-gray-900 transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      <% end %>
      <h1 class="text-lg font-semibold text-gray-900">Unit <%= @lock.unit_identifier %></h1>
    </div>
    <% if @tenancy_status == "available" %>
      <%= link_to "Assign tenant", new_core_lock_access_grant_path(@lock),
            class: "px-3 py-2 text-sm font-medium bg-gray-900 text-white rounded-lg hover:bg-gray-700 transition-colors" %>
    <% else %>
      <span class="px-3 py-2 text-sm font-medium bg-gray-100 text-gray-400 rounded-lg cursor-not-allowed">Assign tenant</span>
    <% end %>
  </div>

  <% if flash[:notice] %>
    <div class="px-4 py-3 rounded-lg bg-green-50 border border-green-200 text-sm text-green-800"><%= flash[:notice] %></div>
  <% end %>

  <% if flash[:alert] %>
    <div class="px-4 py-3 rounded-lg bg-red-50 text-sm text-red-600"><%= flash[:alert] %></div>
  <% end %>

  <turbo-frame id="lock_tab">
    <div class="space-y-6">
      <div class="flex gap-1 border-b border-gray-200">
        <%= link_to "Overview", core_lock_path(@lock, tab: "overview"),
              class: "px-4 py-2 text-sm font-medium border-b-2 transition-colors #{@tab == 'overview' ? 'border-gray-900 text-gray-900' : 'border-transparent text-gray-500 hover:text-gray-900'}",
              data: { turbo_frame: "lock_tab", turbo_action: "advance" } %>
        <%= link_to "Historical access grants", core_lock_path(@lock, tab: "history"),
              class: "px-4 py-2 text-sm font-medium border-b-2 transition-colors #{@tab == 'history' ? 'border-gray-900 text-gray-900' : 'border-transparent text-gray-500 hover:text-gray-900'}",
              data: { turbo_frame: "lock_tab", turbo_action: "advance" } %>
        <%= link_to "Audit trail", core_lock_path(@lock, tab: "audit"),
              class: "px-4 py-2 text-sm font-medium border-b-2 transition-colors #{@tab == 'audit' ? 'border-gray-900 text-gray-900' : 'border-transparent text-gray-500 hover:text-gray-900'}",
              data: { turbo_frame: "lock_tab", turbo_action: "advance" } %>
      </div>

      <% if @tab == "history" %>
        <%= render "history" %>
      <% elsif @tab == "audit" %>
        <%= render "audit" %>
      <% else %>
        <%= render "overview" %>
      <% end %>
    </div>
  </turbo-frame>

</div>
