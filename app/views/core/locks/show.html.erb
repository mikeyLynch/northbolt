<% content_for :title, "Unit #{@lock.unit_identifier}" %>

<div class="max-w-3xl mx-auto space-y-6">

  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <%= link_to core_locks_path, class: "text-gray-400 hover:text-gray-900 transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      <% end %>
      <h1 class="text-lg font-semibold text-gray-900">Unit <%= @lock.unit_identifier %></h1>
    </div>
    <% unless @lock.current_tenant %>
      <%= link_to "Assign tenant", new_core_lock_access_grant_path(@lock),
            class: "px-3 py-2 text-sm font-medium bg-gray-900 text-white rounded-lg hover:bg-gray-700 transition-colors" %>
    <% end %>
  </div>

  <% if flash[:granted_pin] %>
    <div class="px-4 py-4 rounded-xl bg-green-50 border border-green-200 space-y-1">
      <p class="text-sm font-semibold text-green-800">Access granted — PIN issued</p>
      <p class="text-3xl font-mono font-bold tracking-widest text-green-900"><%= flash[:granted_pin] %></p>
      <p class="text-xs text-green-700">This PIN has been sent to the tenant. It will not be shown again.</p>
    </div>
  <% end %>

  <% if flash[:alert] %>
    <div class="px-4 py-3 rounded-lg bg-red-50 text-sm text-red-600"><%= flash[:alert] %></div>
  <% end %>

  <!-- Lock details -->
  <div class="bg-white border border-gray-200 rounded-xl divide-y divide-gray-100">
    <div class="px-4 py-3 flex items-center justify-between">
      <span class="text-sm text-gray-500">Current tenant</span>
      <span class="text-sm text-gray-900">
        <% if @lock.current_tenant %>
          <%= link_to @lock.current_tenant.full_name, core_tenant_path(@lock.current_tenant),
                class: "font-medium hover:underline" %>
        <% else %>
          <span class="text-gray-400">Unoccupied</span>
        <% end %>
      </span>
    </div>
    <div class="px-4 py-3 flex items-center justify-between">
      <span class="text-sm text-gray-500">Location</span>
      <span class="text-sm text-gray-900"><%= @lock.location.name %></span>
    </div>
    <div class="px-4 py-3 flex items-center justify-between">
      <span class="text-sm text-gray-500">Device UUID</span>
      <span class="text-sm font-mono text-gray-900"><%= @lock.device_uuid %></span>
    </div>
    <div class="px-4 py-3 flex items-center justify-between">
      <span class="text-sm text-gray-500">Added</span>
      <span class="text-sm text-gray-900"><%= @lock.created_at.strftime("%-d %B %Y") %></span>
    </div>
  </div>

  <!-- Access history -->
  <div class="space-y-3">
    <h2 class="text-sm font-semibold text-gray-700">Access history</h2>
    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
      <% if @access_grants.any? %>
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-100 bg-gray-50">
              <th class="px-4 py-3 text-left font-medium text-gray-500">Tenant</th>
              <th class="px-4 py-3 text-left font-medium text-gray-500">From</th>
              <th class="px-4 py-3 text-left font-medium text-gray-500 hidden sm:table-cell">Until</th>
              <th class="px-4 py-3 text-left font-medium text-gray-500">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @access_grants.each do |grant| %>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-4 py-3 font-medium text-gray-900">
                  <%= link_to grant.tenant.full_name, core_tenant_path(grant.tenant), class: "hover:underline" %>
                </td>
                <td class="px-4 py-3 text-gray-500"><%= grant.starts_at.strftime("%-d %b %Y") %></td>
                <td class="px-4 py-3 text-gray-500 hidden sm:table-cell"><%= grant.ends_at.strftime("%-d %b %Y") %></td>
                <td class="px-4 py-3">
                  <% if grant.active? %>
                    <span class="text-xs font-medium text-green-600">Active</span>
                  <% else %>
                    <span class="text-xs text-gray-400">Revoked</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="px-4 py-12 text-center text-sm text-gray-400">No access history yet.</div>
      <% end %>
    </div>
  </div>

</div>
