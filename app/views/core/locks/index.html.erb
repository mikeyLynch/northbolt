<% content_for :title, "Locks" %>

<div class="max-w-5xl mx-auto space-y-6">

  <div class="flex items-center justify-between">
    <h1 class="text-lg font-semibold text-gray-900">Locks</h1>
  </div>

  <!-- Search + Sort -->
  <%= form_with url: core_locks_path, method: :get do |f| %>
    <%= f.hidden_field :location_id, value: @location&.id %>
    <div class="flex gap-2">
      <div class="relative flex-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 0 5 11a6 6 0 0 0 12 0z" />
        </svg>
        <%= f.text_field :q, value: @q,
              placeholder: "Search by unit number…",
              class: "w-full pl-10 pr-4 py-2 text-sm border border-gray-200 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent",
              autocomplete: "off" %>
      </div>
      <%= f.select :sort,
            [
              ["Unit number (A–Z)",         "unit_asc"],
              ["Unit number (Z–A)",         "unit_desc"],
              ["Last accessed (newest)",    "last_accessed_desc"],
              ["Last accessed (oldest)",    "last_accessed_asc"]
            ],
            { selected: @sort },
            class: "py-2 px-3 text-sm border border-gray-200 rounded-lg bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-900 cursor-pointer",
            onchange: "this.form.requestSubmit()" %>
    </div>
  <% end %>

  <% if @locations.many? %>
    <!-- Location filter -->
    <div class="flex gap-1 flex-wrap">
      <%= link_to "All", core_locks_path(q: @q, sort: @sort),
            class: "px-3 py-1.5 rounded-lg text-sm font-medium transition-colors #{@location.nil? ? 'bg-gray-900 text-white' : 'text-gray-500 hover:bg-gray-100'}" %>
      <% @locations.each do |location| %>
        <%= link_to location.name, core_locks_path(q: @q, sort: @sort, location_id: location.id),
              class: "px-3 py-1.5 rounded-lg text-sm font-medium transition-colors #{@location == location ? 'bg-gray-900 text-white' : 'text-gray-500 hover:bg-gray-100'}" %>
      <% end %>
    </div>
  <% end %>

  <!-- Table -->
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
    <% if @locks.any? %>
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-100 bg-gray-50">
            <th class="px-4 py-3 text-left font-medium text-gray-500">Unit</th>
            <% if @locations.many? %>
              <th class="px-4 py-3 text-left font-medium text-gray-500">Location</th>
            <% end %>
            <th class="px-4 py-3 text-left font-medium text-gray-500 hidden sm:table-cell">Device UUID</th>
            <th class="px-4 py-3 text-left font-medium text-gray-500 hidden md:table-cell">Connection</th>
            <th class="px-4 py-3 text-left font-medium text-gray-500 hidden md:table-cell">Status</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @locks.each do |lock| %>
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-4 py-3 font-medium text-gray-900"><%= lock.unit_identifier %></td>
              <% if @locations.many? %>
                <td class="px-4 py-3 text-gray-500"><%= lock.location.name %></td>
              <% end %>
              <td class="px-4 py-3 text-gray-400 font-mono text-xs hidden sm:table-cell"><%= lock.device_uuid %></td>
              <td class="px-4 py-3 hidden md:table-cell">
                <% if lock.probably_online? %>
                  <span class="flex items-center gap-1.5 text-xs text-green-600">
                    <span class="w-2 h-2 rounded-full bg-green-500 shrink-0"></span>
                    Online
                  </span>
                <% elsif lock.last_seen_at? %>
                  <span class="flex items-center gap-1.5 text-xs text-red-500">
                    <span class="w-2 h-2 rounded-full bg-red-400 shrink-0"></span>
                    Not connecting
                  </span>
                <% else %>
                  <span class="flex items-center gap-1.5 text-xs text-gray-400">
                    <span class="w-2 h-2 rounded-full bg-gray-300 shrink-0"></span>
                    Never seen
                  </span>
                <% end %>
              </td>
              <td class="px-4 py-3 hidden md:table-cell">
                <% case lock.bolt_position %>
                <% when "Open" %>
                  <span class="flex items-center gap-1.5 text-xs text-red-500">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8 11V7a4 4 0 018 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" />
                    </svg>
                    Open
                  </span>
                <% when "Closed" %>
                  <span class="flex items-center gap-1.5 text-xs text-green-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                    Closed
                  </span>
                <% else %>
                  <span class="text-xs text-gray-400">Unknown</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-right">
                <%= link_to "View", core_lock_path(lock), class: "text-xs font-medium text-gray-500 hover:text-gray-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <% if @locks.total_pages > 1 %>
        <div class="px-4 py-3 border-t border-gray-100 flex items-center justify-between text-sm text-gray-500">
          <span><%= @locks.offset_value + 1 %>–<%= [@locks.offset_value + @locks.limit_value, @locks.total_count].min %> of <%= @locks.total_count %></span>
          <div class="flex gap-1">
            <% unless @locks.first_page? %>
              <%= link_to "← Previous", core_locks_path(page: @locks.prev_page, q: @q, sort: @sort, location_id: @location&.id),
                    class: "px-3 py-1 rounded-lg border border-gray-200 hover:bg-gray-50 transition-colors" %>
            <% end %>
            <% unless @locks.last_page? %>
              <%= link_to "Next →", core_locks_path(page: @locks.next_page, q: @q, sort: @sort, location_id: @location&.id),
                    class: "px-3 py-1 rounded-lg border border-gray-200 hover:bg-gray-50 transition-colors" %>
            <% end %>
          </div>
        </div>
      <% end %>

    <% else %>
      <div class="px-4 py-12 text-center text-sm text-gray-400">
        <% if @q.present? %>
          No locks found matching "<%= @q %>"<%= " in #{@location.name}" if @location %>
        <% elsif @location %>
          No locks at <%= @location.name %>.
        <% else %>
          No locks yet.
        <% end %>
      </div>
    <% end %>
  </div>

</div>
