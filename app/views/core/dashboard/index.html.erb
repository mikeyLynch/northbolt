<% content_for :title, "Dashboard" %>

<div class="space-y-6">

  <% greeting = case Time.current.hour
                when 0..11  then "Good morning"
                when 12..17 then "Good afternoon"
                else             "Good evening"
                end %>
  <h1 class="text-lg font-semibold text-gray-900"><%= greeting %>, <%= current_user.first_name %>.</h1>

  <%# Activity chart %>
  <div class="bg-white border border-gray-200 rounded-xl px-6 py-8">
    <h2 class="text-sm font-medium text-gray-900 mb-4">Access events — last 7 days</h2>
    <div class="h-48">
      <canvas
        data-controller="chart"
        data-chart-labels-value="<%= @chart_data.map { |d| d[:date] }.to_json %>"
        data-chart-data-value="<%= @chart_data.map { |d| d[:count] }.to_json %>"
      ></canvas>
    </div>
  </div>

  <%# Stat cards %>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">

    <div class="bg-white border border-gray-200 rounded-xl px-5 py-4 space-y-1">
      <p class="text-xs font-medium text-gray-500">Units occupied</p>
      <p class="text-2xl font-semibold text-gray-900"><%= @units_occupied %><span class="text-base font-normal text-gray-400"> / <%= @total_units %></span></p>
    </div>

    <div class="bg-white border border-gray-200 rounded-xl px-5 py-4 space-y-1">
      <p class="text-xs font-medium text-gray-500">Locks online</p>
      <p class="text-2xl font-semibold text-gray-900"><%= @locks_online %><span class="text-base font-normal text-gray-400"> / <%= @total_locks %></span></p>
    </div>

    <div class="bg-white border border-gray-200 rounded-xl px-5 py-4 space-y-1">
      <p class="text-xs font-medium text-gray-500">Low battery</p>
      <p class="text-2xl font-semibold <%= @low_battery > 0 ? 'text-amber-500' : 'text-gray-900' %>"><%= @low_battery %></p>
    </div>

    <div class="bg-white border border-gray-200 rounded-xl px-5 py-4 space-y-1">
      <p class="text-xs font-medium text-gray-500">Failed PINs (24h)</p>
      <p class="text-2xl font-semibold <%= @failed_pins_today > 0 ? 'text-red-500' : 'text-gray-900' %>"><%= @failed_pins_today %></p>
    </div>

  </div>

</div>
