<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="margin:0;padding:0;background-color:#f3f4f6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;">

  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f3f4f6;padding:40px 16px;">
    <tr>
      <td align="center">
        <table width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;">

          <!-- Header -->
          <tr>
            <td style="background-color:#111827;border-radius:12px 12px 0 0;padding:24px 32px;">
              <span style="color:#ffffff;font-size:18px;font-weight:700;letter-spacing:-0.3px;">Northbolt</span>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="background-color:#ffffff;padding:32px;border-left:1px solid #e5e7eb;border-right:1px solid #e5e7eb;">

              <p style="margin:0 0 20px;font-size:15px;color:#374151;">Hello <%= @tenant.first_name %>,</p>

              <% if @grants.one? %>
                <%# ── Single lock ── %>
                <p style="margin:0 0 24px;font-size:15px;color:#374151;line-height:1.6;">
                  Your access has been set up for the following storage unit. Enter your PIN on the keypad beside the door, then slide the bolt to open.
                </p>

                <!-- Unit card -->
                <table width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e5e7eb;border-radius:8px;margin-bottom:28px;">
                  <tr>
                    <td style="padding:20px 24px;">
                      <p style="margin:0 0 4px;font-size:13px;font-weight:600;color:#6b7280;text-transform:uppercase;letter-spacing:0.05em;">Storage Unit</p>
                      <p style="margin:0 0 16px;font-size:20px;font-weight:700;color:#111827;">Unit <%= @grants.first.lock.unit_identifier %></p>
                      <p style="margin:0 0 4px;font-size:14px;color:#6b7280;"><%= @business.name %></p>
                      <p style="margin:0 0 16px;font-size:14px;color:#6b7280;"><%= @grants.first.lock.location.name %></p>
                      <table cellpadding="0" cellspacing="0">
                        <tr>
                          <td style="padding-right:24px;">
                            <p style="margin:0 0 2px;font-size:12px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:0.05em;">Access from</p>
                            <p style="margin:0;font-size:14px;color:#374151;"><%= @grants.first.starts_at.strftime("%-d %B %Y") %></p>
                          </td>
                          <td>
                            <p style="margin:0 0 2px;font-size:12px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:0.05em;">Access until</p>
                            <p style="margin:0;font-size:14px;color:#374151;"><%= @grants.first.ends_at.strftime("%-d %B %Y") %></p>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>

                <!-- PIN -->
                <p style="margin:0 0 8px;font-size:13px;font-weight:600;color:#6b7280;text-align:center;text-transform:uppercase;letter-spacing:0.05em;">Your PIN</p>
                <p style="margin:0 0 28px;font-size:52px;font-weight:700;color:#111827;text-align:center;letter-spacing:0.2em;font-family:'Courier New',Courier,monospace;"><%= @grants.first.pin_ciphertext %></p>

              <% elsif @same_pin %>
                <%# ── Multiple locks, shared PIN ── %>
                <p style="margin:0 0 24px;font-size:15px;color:#374151;line-height:1.6;">
                  Your access has been set up for <%= @grants.count %> storage units. Your PIN works on all of them — enter it on the keypad beside any of the doors below, then slide the bolt to open.
                </p>

                <!-- PIN -->
                <p style="margin:0 0 8px;font-size:13px;font-weight:600;color:#6b7280;text-align:center;text-transform:uppercase;letter-spacing:0.05em;">Your PIN</p>
                <p style="margin:0 0 28px;font-size:52px;font-weight:700;color:#111827;text-align:center;letter-spacing:0.2em;font-family:'Courier New',Courier,monospace;"><%= @grants.first.pin_ciphertext %></p>

                <!-- Units -->
                <table width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e5e7eb;border-radius:8px;margin-bottom:28px;border-collapse:separate;border-spacing:0;">
                  <% @grants.each_with_index do |grant, i| %>
                    <tr>
                      <td style="padding:14px 20px;<%= i < @grants.length - 1 ? 'border-bottom:1px solid #f3f4f6;' : '' %>">
                        <p style="margin:0;font-size:14px;font-weight:600;color:#111827;">Unit <%= grant.lock.unit_identifier %></p>
                        <p style="margin:2px 0 0;font-size:13px;color:#6b7280;"><%= grant.lock.location.name %> &middot; <%= grant.starts_at.strftime("%-d %b %Y") %> &ndash; <%= grant.ends_at.strftime("%-d %b %Y") %></p>
                      </td>
                    </tr>
                  <% end %>
                </table>

              <% else %>
                <%# ── Multiple locks, different PINs ── %>
                <p style="margin:0 0 24px;font-size:15px;color:#374151;line-height:1.6;">
                  Your access has been set up for <%= @grants.count %> storage units, each with its own PIN. Enter the PIN for each unit on the keypad beside its door, then slide the bolt to open.
                </p>

                <!-- Units with individual PINs -->
                <% @grants.each_with_index do |grant, i| %>
                  <table width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e5e7eb;border-radius:8px;margin-bottom:12px;">
                    <tr>
                      <td style="padding:16px 20px;">
                        <p style="margin:0 0 2px;font-size:15px;font-weight:700;color:#111827;">Unit <%= grant.lock.unit_identifier %></p>
                        <p style="margin:0 0 12px;font-size:13px;color:#6b7280;"><%= grant.lock.location.name %> &middot; <%= grant.starts_at.strftime("%-d %b %Y") %> &ndash; <%= grant.ends_at.strftime("%-d %b %Y") %></p>
                        <p style="margin:0 0 4px;font-size:11px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:0.05em;">PIN</p>
                        <p style="margin:0;font-size:32px;font-weight:700;color:#111827;letter-spacing:0.2em;font-family:'Courier New',Courier,monospace;"><%= grant.pin_ciphertext %></p>
                      </td>
                    </tr>
                  </table>
                <% end %>

              <% end %>

              <!-- Instructions -->
              <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f9fafb;border-radius:8px;margin-bottom:8px;">
                <tr>
                  <td style="padding:16px 20px;">
                    <p style="margin:0 0 6px;font-size:13px;font-weight:600;color:#374151;">How to access your unit</p>
                    <p style="margin:0;font-size:13px;color:#6b7280;line-height:1.6;">Enter your PIN on the keypad beside the door. When accepted, slide the bolt to open. To lock up, slide the bolt back to the closed position.</p>
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color:#f9fafb;border:1px solid #e5e7eb;border-top:none;border-radius:0 0 12px 12px;padding:20px 32px;text-align:center;">
              <p style="margin:0;font-size:12px;color:#9ca3af;">This email was sent by Northbolt on behalf of <%= @business.name %>. Please do not reply to this email.</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>
</html>
