<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="margin:0;padding:0;background-color:#f3f4f6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;">

  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f3f4f6;padding:40px 16px;">
    <tr>
      <td align="center">
        <table width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;">

          <!-- Header -->
          <tr>
            <td style="background-color:#111827;border-radius:12px 12px 0 0;padding:24px 32px;">
              <span style="color:#ffffff;font-size:18px;font-weight:700;letter-spacing:-0.3px;">Northbolt</span>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="background-color:#ffffff;padding:32px;border-left:1px solid #e5e7eb;border-right:1px solid #e5e7eb;">
              <p style="margin:0 0 20px;font-size:15px;color:#374151;">Hi <%= @business.billing_legal_name %>,</p>
              <p style="margin:0 0 24px;font-size:15px;color:#374151;line-height:1.6;">
                Please find your invoice <strong><%= @invoice.number %></strong> for <%= format("£%.2f", @invoice.total_pence / 100.0) %> (inc. VAT), due by <%= @invoice.due_at.strftime("%-d %B %Y") %>.
              </p>

              <!-- Invoice summary -->
              <table width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e5e7eb;border-radius:8px;margin-bottom:28px;">
                <tr>
                  <td style="padding:20px 24px;">
                    <table width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td style="padding-bottom:8px;">
                          <p style="margin:0;font-size:12px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:0.05em;">Invoice number</p>
                          <p style="margin:4px 0 0;font-size:15px;color:#111827;font-weight:600;"><%= @invoice.number %></p>
                        </td>
                        <td style="padding-bottom:8px;text-align:right;">
                          <p style="margin:0;font-size:12px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:0.05em;">Amount due</p>
                          <p style="margin:4px 0 0;font-size:15px;color:#111827;font-weight:600;"><%= format("£%.2f", @invoice.total_pence / 100.0) %></p>
                        </td>
                      </tr>
                      <tr>
                        <td>
                          <p style="margin:0;font-size:12px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:0.05em;">Due date</p>
                          <p style="margin:4px 0 0;font-size:14px;color:#374151;"><%= @invoice.due_at.strftime("%-d %B %Y") %></p>
                        </td>
                        <td style="text-align:right;">
                          <p style="margin:0;font-size:12px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:0.05em;">Type</p>
                          <p style="margin:4px 0 0;font-size:14px;color:#374151;"><%= @invoice.category.capitalize %><%= @invoice.installment_deposit? ? " (deposit)" : @invoice.installment_delivery? ? " (delivery)" : "" %></p>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- Payment instructions -->
              <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f9fafb;border-radius:8px;margin-bottom:28px;">
                <tr>
                  <td style="padding:16px 20px;">
                    <p style="margin:0 0 4px;font-size:13px;font-weight:600;color:#374151;">Payment by BACS</p>
                    <p style="margin:0;font-size:13px;color:#6b7280;line-height:1.6;"><%= Invoice::COMPANY_BACS %><br>Please reference <strong><%= @invoice.number %></strong> with your payment.</p>
                  </td>
                </tr>
              </table>

              <!-- CTA -->
              <table cellpadding="0" cellspacing="0" style="margin:0 auto;">
                <tr>
                  <td style="background-color:#111827;border-radius:8px;">
                    <a href="<%= core_billing_url %>" style="display:block;padding:12px 24px;color:#ffffff;font-size:14px;font-weight:600;text-decoration:none;">View & download invoice</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color:#f9fafb;border:1px solid #e5e7eb;border-top:none;border-radius:0 0 12px 12px;padding:20px 32px;text-align:center;">
              <p style="margin:0;font-size:12px;color:#9ca3af;"><%= Invoice::COMPANY_NAME %> · Company No: <%= Invoice::COMPANY_NUMBER %> · VAT No: <%= Invoice::COMPANY_VAT %></p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>
</html>
